# Database (PostgreSQL recommended for shared/production data)
DATABASE_URL=postgresql+psycopg://needbridge:change-me@localhost:5432/needbridge

# File storage: local for development, s3 for production
NEEDBRIDGE_STORAGE_BACKEND=local
# For production, use s3; local is allowed only on a persistent mounted disk.
NEEDBRIDGE_PERSISTENT_UPLOADS=0
NEEDBRIDGE_UPLOAD_DIR=./data/uploads
NEEDBRIDGE_MAX_IMAGE_BYTES=5242880
NEEDBRIDGE_MAX_DOCUMENT_BYTES=10485760

# S3-compatible provider settings (Cloudflare R2, AWS S3, etc.)
# NEEDBRIDGE_STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=needbridge-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Application security
APP_ENV=development
NEEDBRIDGE_SECRET=replace-with-a-long-random-secret
NEEDBRIDGE_HTTPS=0

# First PostgreSQL admin (optional; used by backend.init_postgres)
# ADMIN_NAME=NeedBridge Admin
# ADMIN_EMAIL=admin@example.org
# ADMIN_PASSWORD=use-a-unique-long-password
